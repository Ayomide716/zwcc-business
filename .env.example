# ---------------------------------------------------------------------------
# ZWCC Business Grant — mobile environment
#
# Copy to `.env` and fill in with the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# Only EXPO_PUBLIC_* variables are readable from the mobile bundle. Never put a
# service-role key here: anything in the bundle is readable by anyone who has
# the app. The anon key is safe to ship because Row Level Security is what
# actually protects the data (see supabase/migrations/0002_policies.sql).
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Deep link target used in password-reset emails.
EXPO_PUBLIC_APP_SCHEME=zwccgrant
