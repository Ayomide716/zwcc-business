{
  "expo": {
    "name": "ZWCC Business Grant",
    "slug": "zwcc-business-grant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zwccgrant",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#0B2545",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.zionworldcc.businessgrant",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "The app uses your camera so you can capture your passport photograph and business verification documents for your grant application.",
        "NSPhotoLibraryUsageDescription": "The app accesses your photo library so you can attach supporting documents and monthly business progress photos and videos.",
        "NSMicrophoneUsageDescription": "The app uses your microphone when you record a video business progress report.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.zionworldcc.businessgrant",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B2545",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B2545"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ZWCC Business Grant to access your photos so you can attach application documents and monthly progress media.",
          "cameraPermission": "Allow ZWCC Business Grant to use your camera to capture documents and business progress photos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-video",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
